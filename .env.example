# ─────────────────────────────────────────────────────────────────────────────
# KYRO environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way — it holds the HD mnemonic that controls every deposit address.
#
#   pnpm keys:dev     generates a TESTNET-ONLY mnemonic and internal secret
#   pnpm db:start     starts local Supabase (Docker) and prints its keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Network mode ────────────────────────────────────────────────────────────
# "testnet" | "mainnet". Selects the RPC set, address prefixes and explorers.
# Switching to mainnet also requires KYRO_MAINNET_ARMED=yes below.
KYRO_NETWORK_MODE="testnet"

# Deliberate second switch so mainnet can never be reached by a stray env var.
KYRO_MAINNET_ARMED="no"

# ── Custody ─────────────────────────────────────────────────────────────────
# BIP-39 mnemonic. Every user deposit address and the hot wallet derive from it.
# Losing it loses the funds. Use a secret manager in production, not a file.
KYRO_HD_MNEMONIC=""

# Shared secret guarding /api/internal/* (deposit scanner, withdrawal driver).
KYRO_INTERNAL_SECRET=""

# ── RPC endpoints ───────────────────────────────────────────────────────────
# Testnet defaults are public and keyless — dev works with these blank.
# Mainnet requires your own keys; public endpoints will rate-limit a real load.
EVM_ETHEREUM_RPC_URL=""
EVM_BASE_RPC_URL=""
EVM_ARBITRUM_RPC_URL=""
TRON_API_URL=""
TRON_API_KEY=""
BITCOIN_ESPLORA_URL=""
SOLANA_RPC_URL=""

# ── Risk controls ───────────────────────────────────────────────────────────
# Withdrawals at or above this USD value always require operator approval.
KYRO_WITHDRAWAL_APPROVAL_THRESHOLD_USD="250"
# Maximum total value the hot wallet may hold before ops are alerted.
KYRO_HOT_WALLET_CAP_USD="25000"
# Per-user rolling 24h withdrawal ceiling.
KYRO_DAILY_WITHDRAWAL_CAP_USD="2000"

# ── Compliance ──────────────────────────────────────────────────────────────
# ISO-3166 alpha-2, comma separated. Requests from these are refused the games.
KYRO_BLOCKED_COUNTRIES="US,FR,NL,AU,GB"
# Your gaming licence. Left blank deliberately — KYRO invents no licence data.
# Until filled, the games wing shows an unlicensed-preview notice.
KYRO_LICENCE_AUTHORITY=""
KYRO_LICENCE_NUMBER=""
# Support line shown on the responsible-play page. Fill with a real service for
# your market; blank falls back to self-help tools only.
KYRO_HELPLINE_NAME=""
KYRO_HELPLINE_URL=""
